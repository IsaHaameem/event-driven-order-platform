# Copy this file to .env and fill in real values before running `docker compose up`.
# .env itself must NEVER be committed — it's already in .gitignore.

# Shared admin credentials across all 5 Postgres containers (dev convenience —
# they're physically separate database instances regardless of sharing a username).
POSTGRES_USER=order_platform_admin
POSTGRES_PASSWORD=change_me_in_production

# Required once any Kafka KRaft config is customized beyond the image defaults.
# Generate with:
#   docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=

# Optional. Set to a specific customerId (UUID) to deterministically force that
# customer's emails/notifications through the full retry -> Dead Letter Topic path,
# for testing. Leave blank for normal random-failure-rate behavior.
EMAIL_ALWAYS_FAIL_CUSTOMER_ID=
NOTIFICATION_ALWAYS_FAIL_CUSTOMER_ID=
